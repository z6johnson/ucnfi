# LiteLLM (TritonAI) — the sole provider for /api/chat and the daily/
# weekly scan + digest scripts.
LITELLM_API_KEY=
# Optional override; defaults to https://tritonai-api.ucsd.edu
LITELLM_BASE_URL=

# Tier-2 web search runs through the LiteLLM `internet_tool` MCP server.
# Optional override; defaults to ${LITELLM_BASE_URL}/internet_tool/mcp (the
# PUBLIC gateway path). Do NOT point this at the cluster-internal upstream
# (…svc:8080/mcp) — that host isn't routable from CI. Auth reuses
# LITELLM_API_KEY via the `x-litellm-api-key: Bearer <key>` header.
LITELLM_MCP_URL=

# Claude model used by LiteLLM. Defaults to claude-sonnet-4-6.
# Heads up: the UCSD LiteLLM proxy may expose this model under a
# suffixed ID (e.g. `claude-sonnet-4-6-v1`) — if the plain name 404s on
# LiteLLM, set this to whatever ID the proxy accepts.
CLAUDE_MODEL=claude-sonnet-4-6

# Admin gate for editing routes (e.g. /memos/new). Cookie is an HMAC
# keyed by this value, so rotating it invalidates every session.
ADMIN_PASSWORD=

# GitHub-as-CMS. POST /api/memos commits a markdown file to this repo;
# the enrichment review queue at /admin/enrich commits reviewer decisions
# the same way. Vercel's Git integration rebuilds and publishes (~60s).
#
# GITHUB_TOKEN: fine-grained PAT on the single repo below, with
#   - Contents: Read and write   (commit memos, activity, decisions)
#   - Actions:  Read and write   (start the enrichment publish run)
#   No account permissions. Rotate on expiry.
#
#   The Actions permission is what lets the Publish button on
#   /admin/enrich dispatch .github/workflows/enrich-apply.yml — applying a
#   changeset needs a real checkout and python3, so it runs there rather
#   than in the app. Without it, publishing fails with a 403 that reads
#   like a bad token; reviewing and saving decisions still work.
#   Note this is NOT "Workflows: write", which only governs committing
#   files under .github/workflows/ and is not needed.
#
# GITHUB_REPO: owner/repo target for the commit.
# GITHUB_BRANCH: optional, defaults to "main".
GITHUB_TOKEN=
GITHUB_REPO=z6johnson/ucnfi
GITHUB_BRANCH=main

# Postgres — planned for Step 3 (saved chats + shares). Not used yet.
DATABASE_URL=

# Public base URL for share links — added in Step 3
NFI_BASE_URL=http://localhost:3000
